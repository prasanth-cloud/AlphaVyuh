{
  "name": "alphavyuh",
  "private": true,
  "scripts": {
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend run test -- --run",
    "test:e2e:mock": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.mock.config.ts frontend/tests/e2e/workflow-mock.spec.ts",
    "test:e2e:backend": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.backend.config.ts",
    "test:e2e:perf": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.mock.config.ts frontend/tests/e2e/performance-smoke.spec.ts",
    "test:e2e:layout": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.mock.config.ts frontend/tests/e2e/layout-smoke.spec.ts",
    "test:e2e:smoke": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.mock.config.ts frontend/tests/e2e/smoke-signed-in.spec.ts",
    "test:e2e:release": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.release.config.ts frontend/tests/e2e/release-readiness.spec.ts",
    "test:e2e:prod:layout": "PLAYWRIGHT_BASE_URL=https://www.alphavyuh.com npm --prefix frontend exec -- playwright test --config=frontend/playwright.local.config.ts frontend/tests/e2e/layout-smoke.spec.ts",
    "test:e2e:prod:smoke": "PLAYWRIGHT_BASE_URL=https://www.alphavyuh.com PLAYWRIGHT_EXPECT_REAL_DATA=true npm --prefix frontend exec -- playwright test --config=frontend/playwright.local.config.ts frontend/tests/e2e/smoke-signed-in.spec.ts",
    "test:production-api-check": "node scripts/test-check-production-api.mjs",
    "test:production-smoke-env-check": "node scripts/test-check-production-smoke-env.mjs",
    "test:production-signed-in-smoke-workflow-check": "node scripts/test-check-production-signed-in-smoke-workflow.mjs",
    "test:railway-recovery-workflow-check": "node scripts/test-check-railway-recovery-workflow.mjs",
    "test:recovery-handoff-credentials-check": "node scripts/test-check-recovery-handoff-credentials.mjs",
    "test:signed-in-copy-posture-check": "node scripts/test-check-signed-in-copy-posture.mjs",
    "test:public-posture-check": "node scripts/test-check-public-posture.mjs",
    "test:data-recovery-check": "node scripts/test-check-data-recovery-readiness.mjs",
    "test:market-data-entitlement-check": "node scripts/test-check-market-data-entitlement.mjs",
    "test:setup-review-check": "bash scripts/test-setup-review-contract.sh",
    "test:railway-secret-prep": "node scripts/test-prepare-railway-recovery-secrets.mjs",
    "test:ci-action-runtime-check": "node scripts/test-check-ci-action-runtime.mjs",
    "check:public-posture": "node scripts/check-public-posture.mjs",
    "check:recovery-handoff-credentials": "node scripts/check-recovery-handoff-credentials.mjs",
    "check:signed-in-copy-posture": "node scripts/check-signed-in-copy-posture.mjs",
    "check:production-api": "node scripts/check-production-api.mjs",
    "check:production-api:railway": "PRODUCTION_API_URL=https://alphavyuh-production.up.railway.app node scripts/check-production-api.mjs",
    "check:production-smoke-env": "node scripts/check-production-smoke-env.mjs",
    "check:production-signed-in-smoke-workflow": "node scripts/check-production-signed-in-smoke-workflow.mjs",
    "check:railway-recovery-workflow": "node scripts/check-railway-recovery-workflow.mjs",
    "check:data-recovery": "node scripts/check-data-recovery-readiness.mjs",
    "check:ci-action-runtime": "node scripts/check-ci-action-runtime.mjs",
    "prepare:railway-recovery-secrets": "node scripts/prepare-railway-recovery-secrets.mjs",
    "recover:railway-backend:login": "bash scripts/login-and-recover-railway-backend.sh",
    "recover:railway-backend": "bash scripts/recover-railway-backend.sh",
    "launch:check": "bash scripts/launch-readiness-check.sh",
    "broker:smoke": "bash scripts/broker-readonly-smoke.sh",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:types": "npx supabase gen types typescript --local > frontend/lib/supabase/types.ts",
    "db:push:staging": "scripts/db-push-staging.sh",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && .venv/bin/uvicorn app.main:app --reload --port 8000"
  }
}
