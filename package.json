{
  "name": "alphavyuh",
  "private": true,
  "scripts": {
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend run test -- --run",
    "test:e2e:mock": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.mock.config.ts frontend/tests/e2e/workflow-mock.spec.ts",
    "test:e2e:backend": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.backend.config.ts",
    "test:e2e:perf": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.mock.config.ts frontend/tests/e2e/performance-smoke.spec.ts",
    "test:e2e:layout": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.mock.config.ts frontend/tests/e2e/layout-smoke.spec.ts",
    "test:e2e:release": "npm --prefix frontend exec -- playwright test --config=frontend/playwright.release.config.ts frontend/tests/e2e/release-readiness.spec.ts",
    "test:e2e:prod:layout": "PLAYWRIGHT_BASE_URL=https://www.alphavyuh.com npm --prefix frontend exec -- playwright test --config=frontend/playwright.local.config.ts frontend/tests/e2e/layout-smoke.spec.ts",
    "test:production-api-check": "node scripts/test-check-production-api.mjs",
    "test:public-posture-check": "node scripts/test-check-public-posture.mjs",
    "test:data-recovery-check": "node scripts/test-check-data-recovery-readiness.mjs",
    "check:public-posture": "node scripts/check-public-posture.mjs",
    "check:production-api": "node scripts/check-production-api.mjs",
    "check:data-recovery": "node scripts/check-data-recovery-readiness.mjs",
    "recover:railway-backend": "bash scripts/recover-railway-backend.sh",
    "launch:check": "bash scripts/launch-readiness-check.sh",
    "broker:smoke": "bash scripts/broker-readonly-smoke.sh",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:types": "npx supabase gen types typescript --local > frontend/lib/supabase/types.ts",
    "db:push:staging": "scripts/db-push-staging.sh",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && .venv/bin/uvicorn app.main:app --reload --port 8000"
  }
}
