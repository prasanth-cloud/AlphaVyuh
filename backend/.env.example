# Supabase — production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase — staging (set in .env.local only, never committed)
STAGING_SUPABASE_URL=https://<staging-project-ref>.supabase.co
STAGING_SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>

# Supabase — DB push (used by scripts/db-push-staging.sh)
# Get from: Supabase dashboard → staging project → Settings → Database → Connection string → URI
STAGING_SUPABASE_DB_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# Redis — scanner indicator cache (optional; scanner works without it)
REDIS_URL=redis://localhost:6379/0

FRONTEND_URL=http://localhost:3000
INGEST_SERVICE_KEY=generate-with-python-secrets.token_hex-32

# Feedback storage:
# auto tries public.feedback_reports and falls back to waitlist if the migration is missing.
# waitlist avoids the table probe and is safer until production migration 036 is applied.
# table fails fast if public.feedback_reports is unavailable.
FEEDBACK_STORAGE_MODE=auto

# Data ingest strategy:
# Primary Professional Access path is official/free EOD bhavcopy into daily_ohlcv.
# Keep Yahoo refresh disabled in production unless explicitly validating fallback data.
ENABLE_YFINANCE_REFRESH=false

# Market data provider for live quotes/candles.
# mock is deterministic demo data. yahoo is useful for local validation but can rate-limit.
# kite uses Zerodha Kite Connect REST quotes + historical candles for the logged-in account.
# Use truedata/globaldatafeeds after credentials, contracts, and redistribution rights are configured.
MARKET_DATA_PROVIDER=yahoo

# Professional Access broker posture:
# false means broker endpoints are read-only/import-only and /api/v1/orders never submits
# live/sandbox orders even if broker tokens exist. Do not enable without owner approval.
BROKER_LIVE_ORDERS_ENABLED=false
BROKER_CREDS_KEY=generate-64-hex-chars-with-openssl-rand-hex-32

# Professional Access billing posture:
# false means backend Razorpay order creation, verification, and webhook activation are disabled.
# Do not enable without payment/legal/release-candidate approval.
PAYMENT_CHECKOUT_ENABLED=false
FOUNDER_PLAN_CODES=

# Kite order proxy — stable outbound IP for order placement (see docs/kite-proxy.md)
KITE_PROXY_URL=http://alphavyuh-kite-proxy.fly.dev:8888
KITE_PROXY_IP=<fly-ipv4-from-fly-ips-list>

# Zerodha Kite Connect
KITE_API_KEY=your-kite-api-key
KITE_API_SECRET=your-kite-api-secret
# Required only when MARKET_DATA_PROVIDER=kite. Kite access tokens expire daily around 06:00 IST.
# Generate and verify without placing orders:
# BROKER_SMOKE_TARGET=kite npm run broker:smoke -- --login-url
# BROKER_SMOKE_TARGET=kite npm run broker:smoke -- --request-token <request_token>
KITE_ACCESS_TOKEN=your-daily-kite-access-token
# Enables the shared KiteTicker websocket used by /api/v1/market/live/stream.
# One backend process maintains one broker websocket and fans sanitized ticks to browsers.
KITE_STREAM_MODE=quote

# Upstox API v2
UPSTOX_API_KEY=your-upstox-api-key
UPSTOX_API_SECRET=your-upstox-api-secret
UPSTOX_REDIRECT_URI=http://localhost:8000/api/brokers/upstox/connect/callback
# Optional local-only token for backend/scripts/test_upstox_connection.py.
# Do not commit real tokens; Upstox access tokens expire on the broker's schedule.
# Generate and verify without placing orders:
# BROKER_SMOKE_TARGET=upstox npm run broker:smoke -- --login-url
# BROKER_SMOKE_TARGET=upstox npm run broker:smoke -- --code <authorization_code>
UPSTOX_ACCESS_TOKEN=your-upstox-access-token

# Razorpay (Phase 2) — payments + subscriptions
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Sentry — error tracking (set on Railway; optional locally)
SENTRY_DSN=https://<key>@<org>.ingest.us.sentry.io/<project>

# Telegram (Phase 3+) — scan alert notifications
TELEGRAM_BOT_TOKEN=1234567890:AAA-xxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_WEBHOOK_SECRET=generate-a-random-secret-token
