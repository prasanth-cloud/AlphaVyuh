{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next build --webpack >/dev/null && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:mock": "playwright test --config=playwright.mock.config.ts tests/e2e/workflow-mock.spec.ts",
    "e2e:backend": "playwright test --config=playwright.backend.config.ts",
    "e2e:perf": "playwright test --config=playwright.mock.config.ts tests/e2e/performance-smoke.spec.ts",
    "e2e:layout": "playwright test --config=playwright.mock.config.ts tests/e2e/layout-smoke.spec.ts",
    "e2e:scanner-tv": "playwright test --config=playwright.mock.config.ts tests/e2e/scanner-tv-table.spec.ts",
    "e2e:scanner-keyboard": "playwright test --config=playwright.mock.config.ts tests/e2e/scanner-keyboard-nav.spec.ts",
    "e2e:qa-video": "playwright test --config=playwright.qa-video.config.ts tests/e2e/product-walkthrough-video.spec.ts",
    "e2e:qa-video:prod": "PLAYWRIGHT_BASE_URL=https://www.alphavyuh.com playwright test --config=playwright.local.config.ts tests/e2e/product-walkthrough-video.spec.ts",
    "e2e:smoke": "playwright test --config=playwright.mock.config.ts tests/e2e/smoke-signed-in.spec.ts",
    "e2e:prod:smoke": "PLAYWRIGHT_BASE_URL=https://www.alphavyuh.com PLAYWRIGHT_EXPECT_REAL_DATA=true playwright test --config=playwright.local.config.ts tests/e2e/smoke-signed-in.spec.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/nextjs": "^10.76.2",
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.117.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.8.0",
    "next": "16.3.8",
    "next-pwa": "^5.6.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.30",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.30",
    "postcss-selector-parser": "7.1.6",
    "serialize-javascript": "7.0.5"
  }
}
