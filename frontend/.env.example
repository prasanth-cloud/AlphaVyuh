# Supabase — production
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Supabase — staging (set in .env.local only, never committed)
STAGING_SUPABASE_URL=https://<staging-project-ref>.supabase.co
STAGING_SUPABASE_ANON_KEY=<staging-anon-key>

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo/release validation data mode.
# Use mock for deterministic customer demos, live for real backend data.
NEXT_PUBLIC_DATA_MODE=live

# Local/dev fallback guardrails:
# - In development, the frontend uses mock fallback unless force-live is true.
# - In production, keep fallback false unless you are running a controlled demo.
NEXT_PUBLIC_ALLOW_MOCK_FALLBACK=false
NEXT_PUBLIC_FORCE_LIVE_DATA=false

# Supabase CLI / CI — personal access token for migration drift check workflow
# Get from: dashboard.supabase.com → Account → Access tokens → Generate new token
# Set as GitHub repo secret: Settings → Secrets → Actions → SUPABASE_ACCESS_TOKEN
# (not needed locally; only used by check-migration-drift.yml CI job)
SUPABASE_ACCESS_TOKEN=<personal-access-token>

# Sentry — error tracking
# Client-side (sent to browser, must be NEXT_PUBLIC_)
NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Server-side (keep secret)
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_ORG=<sentry-org-slug>
SENTRY_PROJECT=alphavyuh-frontend
SENTRY_AUTH_TOKEN=<token-for-sourcemap-upload>

# Razorpay — billing UI checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
